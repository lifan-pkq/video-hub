[Unit]
Description=NarratoAI Headless Narration Engine (Video Hub)
After=network-online.target narrato-asr.service
Wants=network-online.target

[Service]
Type=simple
User=narratoai
Group=narratoai
WorkingDirectory=/opt/video-hub/narratoai
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONPATH=/opt/video-hub/narratoai
Environment=NARRATO_ENGINE_HOST=127.0.0.1
Environment=NARRATO_ENGINE_PORT=8601
Environment=NARRATO_MAX_ACTIVE=2
EnvironmentFile=-/opt/video-hub/.env
ExecStart=/opt/video-hub/narratoai/.venv/bin/python -m engine.server
Restart=always
RestartSec=5
TimeoutStopSec=60
MemoryMax=3G

[Install]
WantedBy=multi-user.target
