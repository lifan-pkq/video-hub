# 文本模型。不写密钥。剪辑的信号建议不依赖它；解说的「用模型写」依赖它。
VIDEO_HUB_AI_BASE_URL=
VIDEO_HUB_AI_API_KEY=
VIDEO_HUB_AI_MODEL=

# 画面说明。不填则抽帧成功，但每帧标明「未配置视觉模型」。
VIDEO_HUB_VISION_BASE_URL=
VIDEO_HUB_VISION_API_KEY=
VIDEO_HUB_VISION_MODEL=

# 共享 ASR 的完整转写 URL，例如 http://127.0.0.1:8600/v1/audio/transcriptions
VIDEO_HUB_ASR_URL=
# 1 时允许读取视频旁边的 *.transcript.json。演示素材不需要打开这个开关。
VIDEO_HUB_ASR_SIDECAR=0

# 语音。留空时自动选 edge-tts、兼容接口、espeak。不要把 tone 当默认。
VIDEO_HUB_TTS_BASE_URL=
VIDEO_HUB_TTS_API_KEY=
VIDEO_HUB_TTS_MODEL=tts-1
VIDEO_HUB_TTS_VOICE=alloy

# 数据目录。接到现有 Video Hub 时指到它的 data，或单独用 EXTERNAL_DB。
VIDEO_HUB_DATA_DIR=./data
VIDEO_HUB_VIDEOS_DIR=
VIDEO_HUB_DB=
VIDEO_HUB_EXTERNAL_DB=

# 生产库保持 0，避免写入演示片。
VIDEO_HUB_SEED_DEMO=1

# 测试用。正式运行不要设 1，否则长任务没有进度。
VIDEO_HUB_JOBS_INLINE=0
